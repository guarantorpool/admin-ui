# Runs deploy/poll.sh once; started every minute by admin-ui-deploy.timer. Its output is in: journalctl -u admin-ui-deploy
[Unit]
Description=Deploy the admin portal when main has a new tested commit
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /root/projects/admin-ui/deploy/poll.sh
