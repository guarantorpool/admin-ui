# Copy to .env. VITE_ values are built into the bundle and are not secret.
# On the server, docker compose reads the same file and passes the VITE_ values to the image's build (README, Hosting).

# Dev server and preview ports: the two origins the backend allows for CORS
PORT=3001
PREVIEW_PORT=3002

# The backend's API address. The browser calls it directly.
VITE_API_BASE_URL=http://localhost:8080/api

# Minutes without activity, across all tabs, before the portal locks (D-001)
VITE_IDLE_LOCK_MINUTES=5

# Time zone every date and time is shown in (D-002)
VITE_TIME_ZONE=Africa/Nairobi

# Shown in the header as a badge unless it is exactly "prod"
VITE_APP_ENV=local
